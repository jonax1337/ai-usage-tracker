{
  "name": "claude-code-usage-tracker",
  "version": "1.3.0",
  "description": "Local zero-dependency dashboard and CLI for Claude Code token usage, costs, plan limits, and pace predictions",
  "type": "module",
  "bin": {
    "claude-usage": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node server.ts",
    "cli": "node cli.ts",
    "build": "tsc -p tsconfig.web.json",
    "build:node": "tsc -p tsconfig.node.json",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.web.json --noEmit",
    "prepublishOnly": "npm run check && npm run build && npm run build:node"
  },
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "tokens",
    "dashboard",
    "cli",
    "rate-limits",
    "local-first",
    "typescript"
  ],
  "author": "Jonas Laux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonax1337/claude-usage-tracker.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
